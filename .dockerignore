.git
.gitignore
.cursor
.cursorrules
*.md
.env
.env.*
!.env.example
!.env.prod.example

frontend/
deploy/

# Offline bundles land in the repo root (build-bundle.sh step 10). Without this
# exclusion every docker build COPYs all prior bundles into the app image — and the
# non-root chown -R layer then duplicates them — compounding per build (observed:
# 17.6GB app image carrying 2x ~4.3GB of stale tarballs).
tess-offline-bundle-*.tar.gz
tess-offline-bundle-*.tar.gz.sha256

# Eval history is a local artifact; scripts/ is COPYed into the image, so without
# this exclusion every build ships (and the chown -R layer duplicates) a growing db.
scripts/graph_eval/history.db

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

node_modules/
dist/
