# =============================================================================
# OFFLINE / SOVEREIGN deployment profile (Step 4).
#
# Copy to `.env.offline` and set a real OPS_ADMIN_TOKEN before deploying:
#   cp .env.offline.example .env.offline && edit .env.offline
#   docker compose -f docker-compose.offline.yml -p tess-engine \
#                  --env-file .env.offline up -d --no-build
#
# "Offline" means the PLATFORM makes zero required outbound calls. The LLM upstream
# is the deliberate exception: this profile uses Ollama-only (local). See the
# Sovereignty Audit in deploy/MULTI_CLOUD.md.
#
# NOTE: docker-compose.offline.yml is self-contained and bakes the HA + observability
# settings below directly into the services (so the harness/acceptance runs with no
# env file). The only value it interpolates from the environment is OPS_ADMIN_TOKEN.
# The rest are documented here so an operator can see — and, by editing the compose
# file, change — the full config surface of the offline stack.
# =============================================================================

# --- Admin auth (THE one value you MUST set for a real deploy) ----------------
# Fail-closed: gated /ops/* mutations return 503 if no token is configured. Do NOT
# ship the harness default `ha-harness-token`. Generate a strong secret, e.g.:
#   openssl rand -hex 32
# Never commit the real value.
OPS_ADMIN_TOKEN=

# Preferred multi-operator form (JSON map operator_id -> token); overrides the
# single OPS_ADMIN_TOKEN above when set. Leave blank to use the single token.
# OPS_ADMIN_TOKENS={"jesse":"<hex64>"}

# --- LLM provider: Ollama-only (the offline default) --------------------------
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Model must be PRE-SEEDED into the ollama_data volume on the offline host (no
# runtime `ollama pull`). See deploy/MULTI_CLOUD.md §Offline Packaging. The ops
# HA + observability acceptance harness never calls the LLM, so this is only for
# real product use, not for the offline proof.
OLLAMA_MODEL=llama3.2:1b
# Remote providers are the online exception — leave empty for a sovereign deploy.
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Control-plane HA (baked into docker-compose.offline.yml) ------------------
OPS_HA_ENABLED=true
OPS_ETCD_ENDPOINTS=http://etcd:2379
OPS_CP_INSTANCE_ID=cp-a
OPS_ETCD_LEASE_TTL_SECONDS=10
OPS_ETCD_CAMPAIGN_INTERVAL_SECONDS=2

# --- Observability (self-hosted; baked into docker-compose.offline.yml) -------
OPS_METRICS_ENABLED=true
OPS_METRICS_WORKER_PORT=9109
OPS_TRACING_ENABLED=true
# Self-hosted collector only — no hosted/SaaS backend is ever contacted.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Cloud standby: OFF for a sovereign deploy (probe loop stays loopback-only) -
OPS_AWS_BASE_URL=
OPS_GCP_BASE_URL=
