# P2 Step 2 per-node identity — node1 (fsn1): etcd-1 + CP-A + redis + worker.
# Non-secret; secrets live only in the on-node .env.prod (cp-env-sync.sh).
ETCD_NAME=etcd-1
NODE_WG_IP=10.8.0.1
# Local member first: the consensus failover ladder tries endpoints in order
# (app/ops/consensus.py, 2.0 s each).
OPS_ETCD_ENDPOINTS=http://10.8.0.1:2379,http://10.8.0.2:2379,http://10.8.0.3:2379
OPS_CP_INSTANCE_ID=cp-a
CP_PUBLISH_PORT=8000
P2_REDIS_URL=redis://10.8.0.1:6379/0
