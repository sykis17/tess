# P2 Step 2 per-node identity — node3 (hel1): etcd-3 only (quorum witness).
# CP/redis values below are inert (no profile activates those services here);
# present so `docker compose config` resolves the whole file without warnings.
ETCD_NAME=etcd-3
NODE_WG_IP=10.8.0.3
OPS_ETCD_ENDPOINTS=http://10.8.0.3:2379,http://10.8.0.1:2379,http://10.8.0.2:2379
OPS_CP_INSTANCE_ID=unused-witness
CP_PUBLISH_PORT=8000
P2_REDIS_URL=redis://10.8.0.1:6379/0
